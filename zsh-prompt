# shellcheck disable=SC2154
# shellcheck disable=SC2079
# shellcheck disable=SC2034
# shellcheck disable=SC2016
# shellcheck disable=SC2140

# Function to set up custom ZSH prompt with git status
# NOTE: Run `set -x` in the terminal to debug when things go strange!

typeset -gA _ZZ_PROMPT
typeset -gA _ZD  # Git info: set by dotfiles, or by _git_stline without it
_ZZ_PROMPT=(
    # Prompt (colors: K=background, F=foreground)
    [f]='#ffffff'    # (F) global foreground color
    [width]='40'     # Prompt width
    [nf]='on'        # Use Nerd Fonts 'on' (default) or 'off' (plain text)
    [dn]='2'         # Repo/venv depth shown as '/' per level; deeper shows '-d<n>'

    ## PS1
    [b]='#0064e4'    # (K) PWD
    [p1]='\ue0b4'    # Trailing divider

    ## RPS1
    [r1]='\ue0b6'   # Leading divider

    ### Home 
    [u]=''           # user@host ("%n@%m")
    [h]='\U000f07d2' # HOME
    [p]='\uea83'     # Folder
    [pt]='+'         # Leading marker when the path is shortened
    [ssh]='\ue8b1 \U000f08c0 '   # Ssh
 
    ### Git
    [gs]=''         # Status line message
    [gt]='\ue65d'   # Git glyph
    [gb]='\ue725'   # Branch glyph
    [gd]='\ue5fb'   # Git glyph (dotfiles folder)
    [gg]=''         # computed: [gd] if track else [gt]
    [gx]='#d6000c'  # (K) Working tree changes
    [go]='#008400'  # (K) Working tree clean
    [gc]=''         # Either [gx] or [go]: not user config
    [gv]='left'     # Repo segment placement: 'left', 'right', 'off'
    [ga]='icon'     # 'icon', 'text', 'icontext'
    
    ### Virtual Environment
    [vo]='left'     # Venv segment placement: 'left', 'right', 'off'
    [py]='\ue606'   # Python glyph
    [cv]='#c7008b'  # (K) Outside project folder
    [vt]='icon'     # 'icon', 'text', 'icontext'

    ### System
    [t]='%D{%H:%M}' # Date/Time
    [x]='#d6000c'   # (K) Last command error

    ### Runtime (set by P; not user config)
    [k]=''          # Current segment background
    [xs]=0          # Color to use based on exit status: go or x 
)

_setup_prompt() {
    # PROMPT_SUBST must stay off: PS1 holds untrusted text (paths, branch),
    # so a name like '$(cmd)' would run. Every segment is built in precmd.
    zmodload zsh/datetime

    # Untrusted text → literal PS1 text in $REPLY. Control chars become '?'
    # (no terminal escape injection); '%' is doubled.
    _esc() {
        REPLY=${${1//[[:cntrl:]]/?}//\%/%%}
    }

    M(){
        # Suppress Nerd Font glyph keys when [nf]=off
        if [[ ${_ZZ_PROMPT[nf]} == off ]]; then
            case $1 in
                p1|h|p|gt|gb|gd|gg|r1|py) return ;;
                ssh) print -n -- "ssh"; return ;;
            esac
        fi
        print -n -- "${_ZZ_PROMPT[$1]}"
    }

    # Foreground from _ZZ_PROMPT key (calls M).
    F() {
        print -nr -- "%{%F{$(M "$1")}%}"
    }

    # Background from _ZZ_PROMPT key (calls M).
    K() {
        print -nr -- "%{%K{$(M "$1")}%}"
    }

    # Segment painter, must run in the parent shell (not $(P …))
    # so that [k] is updated for the next segment. Appends to $_ZZ_OUT
    # (reset by _ps1 / _rps1 before building).
    #
    #   P <bg> <fg_key>   open/continue: K(bg) F(fg); [k]=bg
    #   P <bg> trail      PS1 sep:       K(bg) F([k]) p1 F(f); [k]=bg
    #   P <bg> lead       RPS1 sep:      F(bg) r1 F(f) K(bg); [k]=bg
    typeset -g _ZZ_OUT

    P() {
        local bg=$1 mode=$2
        case ${mode:-lead} in
            trail)
                _ZZ_OUT+="$(K "$bg"; F "${_ZZ_PROMPT[k]}"; M p1; F f)"
                ;;
            lead)
                (( $# == 1 )) && bg="${_ZZ_PROMPT[xs]}"
                _ZZ_OUT+="$(F "$bg"; M r1; F f; K "$bg")"
                ;;
            init)
                _ZZ_OUT=$(R)
                _ZZ_PROMPT[k]=
                [[ $1 == "ps1" ]] && P b f && bg="b"
                ;;
            close)
                [[ $1 == "ps1" ]] && PS1="$_ZZ_OUT$(R; F "${_ZZ_PROMPT[k]}"; M p1)%f " || RPS1=$_ZZ_OUT
                bg=
                ;;
            *)
                # mode is a foreground colour key
                _ZZ_OUT+="$(K "$bg"; F "$mode")"
                ;;
        esac
        _ZZ_PROMPT[k]="$bg"
    }

    R() {
        # Prevent Terminal.app from brightening font color with no background.
        # Not needed for truecolor terminals.
        #
        # https://apple.stackexchange.com/questions/282911/
        # prevent-mac-terminal-brightening-font-color-with-no-background/446604#446604
        local k
        _AT256 && k="%k%{\e[48;5;256m%}" || k='%k'
        print -n -- "$k"
    }

    # Client OS/terminal, forwarded over ssh via SendEnv/AcceptEnv LANG LC_*
    # so _AT256 reflects the local Terminal.app, not the remote host.
    # Kernel name and version of the running OS (uname -sr), not $OSTYPE,
    # which is the OS zsh was built on: e.g. "Darwin 24.6.0".
    [[ -z $SSH_TTY ]] && export LC_OS="$(uname -sr)" LC_TERM_PROGRAM=$TERM_PROGRAM

    # Terminal.app before macOS 26 (darwin 25). Pattern match, not arithmetic,
    # since LC_OS may come from the ssh client.
    _AT256() {
        [[ $LC_TERM_PROGRAM == Apple_Terminal && $LC_OS == "Darwin "<0-24>(|.*) ]]
    }

    # Map '#rrggbb' colours to the nearest 256-colour index where there is no truecolor.
    _AT256 && zmodload zsh/nearcolor

    # Update Git status before each prompt
    _git_pre() {
        if (( $+functions[dotfiles] )); then
            dotfiles --zsh-prompt
        else
            _git_stline
        fi
        _esc "${_ZD[prompt]}"
        _ZZ_PROMPT[gs]=$REPLY
        # One git indicator: select correct git glyph based on whether normal git folder or dotfile bare repo. 
        [[ ${_ZD[track]} == "1" && $(M ga) == icon ]] && _ZZ_PROMPT[gg]=${_ZZ_PROMPT[gd]} || _ZZ_PROMPT[gg]=${_ZZ_PROMPT[gt]}
        [[ ${_ZZ_PROMPT[gs]} =~ [+~?] ]] && _ZZ_PROMPT[gc]=$(M gx) || _ZZ_PROMPT[gc]=$(M go)
    }

    _sec_user() {
        local _u
        _u=$(M u)
        [[ -n "$SSH_CLIENT" || -n "$SSH_TTY" ]] && _u="$(M ssh):%n@%m"
        _ZZ_OUT+="$_u"
    }

    # Where the path goes in $_ZZ_OUT (set by _ps1); _pwd_fit inserts it once
    # the rest of PS1 is built, so it knows how much width later segments take.
    typeset -gi _ZZ_PWD_AT

    # Fit prefix + path + later segments into [width]: shorten directories
    # left to right to one letter (two for dot dirs), keeping the last whole.
    # If that still doesn't fit, left-truncate the path only.
    _pwd_fit() {
        local pre dir tail mark
        local -a parts
        local -i i room

        if [[ $PWD == "$HOME" || $PWD == $HOME/* ]]; then
            dir=${PWD#"$HOME"}
            [[ ${_ZZ_PROMPT[nf]} == off ]] && pre="~" || pre=" $(M h) "
        else
            dir=$PWD
            [[ ${_ZZ_PROMPT[nf]} == off ]] && pre= || pre=" $(M p) "
        fi

        # Visible width of what follows the path (strip %{…%} escapes,
        # then undo _esc's %% → %).
        tail=${${(S)${_ZZ_OUT[_ZZ_PWD_AT+1,-1]}//\%\{*\%\}}//\%\%/%}
        room=$(( $(M width) - ${(m)#pre} - ${(m)#tail} ))

        parts=("${(@s:/:)dir}")
        for (( i = 2; i < $#parts && ${(m)#dir} > room; i++ )); do
            [[ ${parts[i]} == .* ]] && parts[i]=${parts[i][1,2]} || parts[i]=${parts[i][1]}
            dir=${(j:/:)parts}
        done
        (( i > 2 )) && mark=$(M pt)

        _esc "$dir"
        if (( ${(m)#dir} > room )); then
            dir="%$(( room > 3 ? room : 3 ))<..<$REPLY%<<"
        else
            dir=$REPLY
        fi
        _ZZ_OUT="${_ZZ_OUT[1,_ZZ_PWD_AT]}$pre$mark$dir${_ZZ_OUT[_ZZ_PWD_AT+1,-1]}"
    }

    # Venv segment, when [vo] matches the side $1 ('left' or 'right').
    # Background [b] inside the project folder, [cv] outside it.
    _sec_venv() {
        [[ -z $VIRTUAL_ENV || ${_ZZ_PROMPT[vo]} != "$1" ]] && return

        local venv bg mode=trail
        [[ $1 == right ]] && mode=lead
        venv="${VIRTUAL_ENV%/*}"
        if [[ $PWD == "$venv"/* || $PWD == "$venv" ]]; then
            bg=b
            venv="$(_depth "$venv")${VIRTUAL_ENV##*/}"
        else
            bg=cv
            venv=${venv/#$PWD/}
            venv="${venv/#$HOME/~}"
        fi
        P $bg $mode
        _esc "$venv"
        _ZZ_OUT+="$(_disp_type "$REPLY" "$(M py)" "${_ZZ_PROMPT[vt]}")"
    }

    _git_folder (){
        local repo dir depth
       
        repo="${_ZD[gitdir]%/}"
        dir="${repo%/*}"
        depth=$(_depth "$dir")
        _esc "$depth${repo##*/}"

        _disp_type "$REPLY" "$(M gg)" "${_ZZ_PROMPT[ga]}"
    }

    _disp_type() {
        local disp
        if [[ ${_ZZ_PROMPT[nf]} == off ]]; then
            disp="$1"
        else
            case $3 in
                icon) disp="$2" ;;
                text) disp="$1" ;;
                icontext) disp="$2 $1" ;;
            esac
        fi
        print -nr -- "$disp "
    }

    _depth() {
        # Depth of PWD below base path $1 (Python venv or .git/) as "/"
        # repeated once per directory level. Depths beyond [dn] collapse to
        # the shorthand "-d<depth>".
        local relative result
        local -i depth=0

        # Compare by inode (-ef): APFS is case-insensitive by default,
        # so $PWD may differ in case from the git/venv path (e.g. zoxide
        # caching a differently-cased path). Strip the prefix by length to
        # keep $PWD's actual casing.
        [[ "${PWD:${#1}:1}" == / && "${PWD:0:${#1}}" -ef "$1" ]] && relative="${PWD:${#1}+1}"
        [[ -n "$relative" ]] && depth=$(( ${#${relative//[^\/]}} + 1 ))
        if (( depth > ${_ZZ_PROMPT[dn]} )); then
            result="-d${depth} "
        else
            repeat $depth; result+="/"
        fi

        print -n -- "$result"
    }

    # Fallback when dotfiles is not installed: sets _ZD[gitdir] and
    # _ZD[prompt] ("branch +staged ~unstaged ?untracked") like dotfiles does.
    _git_stline() {
        local -a lines
        lines=("${(@f)$(git rev-parse --absolute-git-dir --abbrev-ref HEAD 2>/dev/null)}")
        _ZD[gitdir]=${lines[1]}
        _ZD[prompt]=${lines[2]}
        _ZD[track]=0
        [[ -z ${_ZD[prompt]} ]] && return

        local -i s
        lines=("${(@f)$(git status --porcelain 2>/dev/null)}")
        s=${#${(M)lines:#[MTADRC]*}};  ((s)) && _ZD[prompt]+=" +$s" # staged
        s=${#${(M)lines:#?[MTDRC]*}};  ((s)) && _ZD[prompt]+=" ~$s" # unstaged
        s=${#${(M)lines:#\?\?*}};      ((s)) && _ZD[prompt]+=" ?$s" # untracked
    }

    _sec_vcs_iff() {
        [[ -z ${_ZZ_PROMPT[gs]} ]] && return
        if [[ $1 == "left" && ${_ZZ_PROMPT[gv]} == "left" ]]; then
            P gc trail
            # Git: glyph + git folder + branch glyph + changes
            _ZZ_OUT+=" $(_git_folder; M gb)  ${_ZZ_PROMPT[gs]}"
        fi
    }

    _last_exit_status() {
        (( $? )) && _ZZ_PROMPT[xs]=x || _ZZ_PROMPT[xs]=go
    }

    # Left: user + pwd, then git 
    _ps1() {
        P ps1 init
        _sec_user
        _ZZ_PWD_AT=${#_ZZ_OUT}
        _sec_venv left
        _sec_vcs_iff left
        _pwd_fit
        P ps1 close
    }

    # Right: optional venv/repo (lead), then time + exit status.
    _rps1() {
        P rps1 init
        _sec_venv right
        P lead
        _ZZ_OUT+="$(M t)"
        P rps1 close
    }

    _time_ps1() {
        local start=$EPOCHREALTIME
        _ps1
        printf "PS1: %.3f ms\n" $(( (EPOCHREALTIME - start) * 1000 )) 
    }

    _time_rps1() {
        local start=$EPOCHREALTIME stop 
        _rps1
        printf "RPS1: %.3f ms\n" $(( (EPOCHREALTIME - start) * 1000 ))
    }

    # Hooks to update the prompt, added alongside other plugins' hooks
    # (-U keeps entries unique when the file is re-sourced).
    # Note: to time each section use _time_ps1 _time_rps1 in place of _ps1 _rps1
    typeset -gU precmd_functions
    precmd_functions+=(_git_pre _last_exit_status _ps1 _rps1)
}

_chpwd_update() {
    # Raw print (no prompt expansion); control chars in the path become '?'.
    print -rn -- $'\e]2;'"${${PWD/#$HOME/~}//[[:cntrl:]]/?}"$'\a'
}

chpwd_functions+=(_chpwd_update)

_setup_prompt
_chpwd_update
