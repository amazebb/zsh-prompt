# shellcheck disable=SC2154
# shellcheck disable=SC2079
# shellcheck disable=SC2034
# shellcheck disable=SC2016
# shellcheck disable=SC2140

# Function to set up custom ZSH prompt with git status
# NOTE: Run `set -x` in the terminal to debug when things go strange!

typeset -gA _ZZ_PROMPT
_ZZ_PROMPT=(
    # Prompt (colors: K=background, F=foreground)
    [f]='white'      # (F) global foreground color
    [width]='40'     # Prompt width
    [nf]='on'        # Use Nerd Fonts 'on' (default) or 'off' (plain text)

    ## PS1
    [b]='blue'       # (K) PWD
    [p1]='\ue0b4'    # Trailing divider

    ## RPS1
    [r1]='\ue0b6'   # Leading divider

    ### Home 
    [u]=''           # user@host ("%n@%m")
    [h]='\U000f07d2' # HOME
    [p]='\uea83'     # Folder
    [ssh]='\ue8b1 \U000f08c0 '   # Ssh
 
    ### Git
    [gs]=''         # Status line message
    [gt]='\ue65d'   # Git glyph
    [gb]='\ue725'   # Branch glyph
    [gd]='\ue5fb'   # Git glyph (dotfiles folder)
    [gg]=''         # computed: [gd] if track else [gt]
    [gx]='red'      # (K) Working tree changes
    [go]='green'    # (K) Working tree clean
    [gc]=''         # Either [gx] or [go]: not user config
    [gv]='left'     # Repo segment placement: 'left', 'right', 'off'
    [ga]='icon'     # 'icon', 'text', 'icontext'
    
    ### Virtual Environment
    [vo]='left'     # Venv segment placement: 'left', 'right', 'off'
    [py]='\ue606'   # Python glyph
    [cv]='magenta'  # (K) Outside project folder
    [vt]='icon'     # 'icon', 'text', 'icontext'
    [vv]=''         # b or cv: not user config

    ### System
    [t]='%D{%H:%M}' # Date/Time
    [x]='red'       # (K) Last command error

    ### Runtime (set by P; not user config)
    [k]=''          # Current segment background
    [xs]=0          # Color to use based on exit status: go or x 
)

_setup_prompt() {
    # Enable command substitution in prompt
    setopt PROMPT_SUBST
    zmodload zsh/datetime
    
    M(){
        # Suppress Nerd Font glyph keys when [nf]=off
        if [[ ${_ZZ_PROMPT[nf]} == off ]]; then
            case $1 in
                p1|h|p|gt|gb|gd|gg|r1|py) return ;;
                ssh) print -n -- "ssh"; return ;;
            esac
        fi
        print -n -- "${_ZZ_PROMPT[$1]}"
    }

    # Foreground from _ZZ_PROMPT key (calls M).
    F() {
        print -nr -- "%{%F{$(M "$1")}%}"
    }

    # Background from _ZZ_PROMPT key (calls M).
    K() {
        print -nr -- "%{%K{$(M "$1")}%}"
    }

    # Segment painter, must run in the parent shell (not $(P …))
    # so that [k] is updated for the next segment. Appends to $_ZZ_OUT
    # (reset by _ps1 / _rps1 before building).
    #
    #   P <bg> <fg_key>   open/continue: K(bg) F(fg); [k]=bg
    #   P <bg> trail      PS1 sep:       K(bg) F([k]) p1 F(f); [k]=bg
    #   P <bg> lead       RPS1 sep:      F(bg) r1 F(f) K(bg); [k]=bg
    typeset -g _ZZ_OUT

    P() {
        local bg=$1 mode=$2
        case ${mode:-lead} in
            trail)
                _ZZ_OUT+="$(K "$bg"; F "${_ZZ_PROMPT[k]}"; M p1; F f)"
                ;;
            lead)
                (( $# == 1 )) && bg="${_ZZ_PROMPT[xs]}"
                _ZZ_OUT+="$(F "$bg"; M r1; F f; K "$bg")"
                ;;
            init)
                _ZZ_OUT=$(R)
                _ZZ_PROMPT[k]=
                [[ $1 == "ps1" ]] && P b f && bg="b"
                ;;
            close)
                [[ $1 == "ps1" ]] && PS1="$_ZZ_OUT$(R; F "${_ZZ_PROMPT[k]}"; M p1)%f " || RPS1=$_ZZ_OUT
                bg=
                ;;
            *)
                # mode is a foreground colour key
                _ZZ_OUT+="$(K "$bg"; F "$mode")"
                ;;
        esac
        _ZZ_PROMPT[k]="$bg"
    }

    R() {
        # Prevent Terminal.app from brightening font color with no background.
        # Not needed for truecolor terminals.
        #
        # https://apple.stackexchange.com/questions/282911/
        # prevent-mac-terminal-brightening-font-color-with-no-background/446604#446604
        _AT256 && k="%k%{\e[48;5;256m%}" || k='%k'
        print -n -- "$k"
    }

    _AT256() {
        [[ $OSTYPE == darwin* ]] && [[ $TERM_PROGRAM == Apple_Terminal ]] \
            && (( ${OSTYPE#darwin} < 25.0 ))
    }

    # Update Git status before each prompt
    precmd() {
        dotfiles --zsh-prompt
        _ZZ_PROMPT[gs]=$(_git_status_line)
        # One git indicator: select correct git glyph based on whether normal git folder or dotfile bare repo. 
        [[ ${_ZD[track]} == "1" && $(M ga) == icon ]] && _ZZ_PROMPT[gg]=${_ZZ_PROMPT[gd]} || _ZZ_PROMPT[gg]=${_ZZ_PROMPT[gt]}
        [[ $(M gs) =~ [+~?] ]] && _ZZ_PROMPT[gc]=$(M gx) || _ZZ_PROMPT[gc]=$(M go)
    }

    _sec_user() {
        local _u
        _u=$(M u)
        [[ -n "$SSH_CLIENT" || -n "$SSH_TTY" ]] && _u="$(M ssh):%n@%m"
        _ZZ_OUT+="$_u"
    }

    _sec_pwd() {
        local p
        if [[ ${_ZZ_PROMPT[nf]} == off ]]; then
            # Plain text: put ~ in the left-truncation marker so it survives
            # %width<…< truncation (same idea as the home glyph in Nerd Font mode).
            if [[ $PWD = "$HOME" ]]; then
                p="<..<~"
            elif [[ $PWD == $HOME/* ]]; then
                p="<~..<~${PWD#"$HOME"}"
            else
                p="<..<$PWD"
            fi
        else
            if [[ $PWD = "$HOME" ]]; then
                p="<..< $(M h) "
            elif [[ $PWD == $HOME/* ]]; then
                p="< $(M h) ..< $(M h) ${PWD#"$HOME"}"
            else
                p="< $(M p)  ..< $(M p) $PWD"
            fi
        fi
        _ZZ_OUT+="%$(M width)$p"
    }

    # Git: glyph + git folder + branch glyph + changes
    _vcs() {
        _ZZ_OUT+=" $(_git_folder; M gb)  ${_ZZ_PROMPT[gs]}"
    }

    # Venv path 
    _venv() {
        _ZZ_OUT+="$_ZZ_VENV_TEXT"
    }

    typeset -g _ZZ_VENV_TEXT

    _venv_pre() {
        _ZZ_VENV_TEXT=
        [[ -z $VIRTUAL_ENV || ${_ZZ_PROMPT[vo]} == "off" ]] && return
       
        local venv 
        venv="${VIRTUAL_ENV%/*}"
        if [[ $PWD == "$venv"/* || $PWD == "$venv" ]]; then
            _ZZ_PROMPT[vv]=b
            venv=$(_venv_path "$venv")
            venv="$venv${VIRTUAL_ENV##*/}"
        else
            _ZZ_PROMPT[vv]=cv
            venv=${venv/#$PWD/}
            venv="${venv/#$HOME/~}"
        fi
        _ZZ_VENV_TEXT="$(_disp_type "$venv" "$(M py)" "${_ZZ_PROMPT[vt]}")"
    }

    _git_folder (){
        local repo dir depth
       
        repo="${_ZD[gitdir]%/}"
        dir="${repo%/*}"
        depth=$(_venv_path "$dir")
        dir="$depth${repo##*/}"

        _disp_type "$dir" "$(M gg)" "${_ZZ_PROMPT[ga]}"
    }

    _disp_type() {
        if [[ ${_ZZ_PROMPT[nf]} == off ]]; then
            disp="$1"
        else
            case $3 in
                icon) disp="$2" ;;
                text) disp="$1" ;;
                icontext) disp="$2 $1" ;;
            esac
        fi
        print -nr -- "$disp "
    }

    # Clock 
    _sec_time() {
        _ZZ_OUT+="$(M t)"
    }

    _venv_path() {
        # Calculate relative path from $1 to given directory as "/"
        # notation.
        # Given a base path (Python venv or .git/), returns
        # a string of "/" repeated for each directory level between
        # the base and PWD. Depths beyond $2 (default 2) collapse to
        # the shorthand "-d<depth>".
        local relative result
        local -i depth=0 depth_n=${2:-2}

        # Compare by inode (-ef): APFS is case-insensitive by default,
        # so $PWD may differ in case from the git/venv path (e.g. zoxide
        # caching a differently-cased path). Strip the prefix by length to
        # keep $PWD's actual casing.
        [[ "${PWD:${#1}:1}" == / && "${PWD:0:${#1}}" -ef "$1" ]] && relative="${PWD:${#1}+1}"
        [[ -n "$relative" ]] && depth=$(( ${#${relative//[^\/]}} + 1 ))
        if (( depth > depth_n )); then
            result="-d${depth} "
        else
            repeat $depth; result+="/"
        fi

        print -n -- "$result"
    }

    # Git status - uses dotfiles if available, otherwise _git_stline
    _git_status_line() {
        if (($+functions[dotfiles])); then
            echo "${_ZD[prompt]}"
        else
            _git_stline
        fi
    }

    # Fallback git status line for standard git repos
    _git_stline() {
        local p
        if [[ -n $porcelain ]]; then
            local -i s=0
            s=$(echo "$porcelain" | grep -c "^[MTADRC]")
            ((s)) && p+=" +$s" # staged
            s=$(echo "$porcelain" | grep -c "^.[MTDRC]")
            ((s)) && p+=" ~$s" # unstaged
            s=$(echo "$porcelain" | grep -c "^??")
            ((s)) && p+=" ?$s" # untracked
        fi
        echo "$p"
    }

    _sec_vcs_iff() {
        [[ -z ${_ZZ_PROMPT[gs]} ]] && return
        if [[ $1 == "left" && ${_ZZ_PROMPT[gv]} == "left" ]]; then
            P gc trail
            _vcs
        fi
    }

    _sec_venv_iff() {
        [[ -z $VIRTUAL_ENV || ${_ZZ_PROMPT[vo]} == "off" ]] && return
        if [[ $1 == "left" && ${_ZZ_PROMPT[vo]} == "left" ]]; then
            P "${_ZZ_PROMPT[vv]}" trail
            _venv
        elif [[ $1 == "right" && ${_ZZ_PROMPT[vo]} == "right" ]]; then
            P "${_ZZ_PROMPT[vv]}" lead
            _venv
        fi
    }

    _last_exit_status() {
        _ZZ_PROMPT[xs]=$? 
        if (( _ZZ_PROMPT[xs] == 0 )); then
            _ZZ_PROMPT[xs]="go"
        else
            _ZZ_PROMPT[xs]="x"
        fi
 }

    # Left: user + pwd, then git 
    _ps1() {
        P ps1 init
        _sec_user
        _sec_pwd
        _sec_venv_iff left
        _sec_vcs_iff left
        P ps1 close
    }

    # Right: optional venv/repo (lead), then time + exit status.
    _rps1() {
        P rps1 init
        _sec_venv_iff right
        P lead
        _sec_time
        P rps1 close
    }

    _time_ps1() {
        local start=$EPOCHREALTIME
        _ps1
        printf "PS1: %.3f ms\n" $(( (EPOCHREALTIME - start) * 1000 )) 
    }

    _time_rps1() {
        local start=$EPOCHREALTIME stop 
        _rps1
        printf "RPS1: %.3f ms\n" $(( (EPOCHREALTIME - start) * 1000 ))
    }

    # Final hook to update prompt
    # Note: to timeeach section use (_time_ps1 _time_rps1)
    precmd_functions=(_venv_pre _last_exit_status _ps1 _rps1)
}

_chpwd_update() {
    print -nP '\e]2;${PWD/#$HOME/\~}\a'
}

chpwd_functions+=(_chpwd_update)

_setup_prompt
_chpwd_update
